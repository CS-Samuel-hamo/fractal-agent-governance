{
  "name": "zoo-agent-run-launcher",
  "displayName": "Zoo Agent Run Launcher",
  "description": "Lightweight v0.3.10 progress, bootstrap, redirect, resume safety, task-board, parallel safety, and Codex CLI worker bridge controls for Zoo Agent Governance runs.",
  "version": "0.3.11",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:agentGovernanceProgress",
    "onCommand:zooAgentLauncher.promptNow",
    "onCommand:zooAgentLauncher.startGovernanceIntake",
    "onCommand:zooAgentLauncher.copyAgentRun",
    "onCommand:zooAgentLauncher.openZooCode",
    "onCommand:zooAgentLauncher.resetWorkspacePrompt",
    "onCommand:agentGovernance.showQuickActions",
    "onCommand:agentGovernance.showProgress",
    "onCommand:agentGovernance.redirectCurrentRun",
    "onCommand:agentGovernance.copyResumeCommand",
    "onCommand:agentGovernance.stopThenSnapshot",
    "onCommand:agentGovernance.openTaskBoard",
    "onCommand:agentGovernance.applyTaskBoard",
    "onCommand:agentGovernance.runResumeSafetyCheck",
    "onCommand:agentGovernance.openMergeQueue",
    "onCommand:agentGovernance.openResourceLocks",
    "onCommand:agentGovernance.openParallelReport",
    "onCommand:agentGovernance.refreshProgressTree",
    "onCommand:agentGovernance.openLatestRunFolder",
    "onCommand:agentGovernance.generateCodexTaskPack",
    "onCommand:agentGovernance.runCodexWorker",
    "onCommand:agentGovernance.openCodexTaskPrompt",
    "onCommand:agentGovernance.copyCodexTaskPrompt",
    "onCommand:agentGovernance.collectCodexResult",
    "onCommand:agentGovernance.runCodexScopeGuard",
    "onCommand:agentGovernance.openCodexResult",
    "onCommand:agentGovernance.runExecutorBenchmark",
    "onCommand:agentGovernance.bootstrapProject",
    "onCommand:agentGovernance.openBootstrapReport",
    "onCommand:agentGovernance.rerunBootstrap",
    "onCommand:agentGovernance.commitBootstrapFiles",
    "onCommand:agentGovernance.openProjectReadiness"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "zooAgentLauncher.promptNow", "title": "Zoo Agent Launcher: Show Governance Prompt" },
      { "command": "zooAgentLauncher.startGovernanceIntake", "title": "Zoo Agent Launcher: Start Governance Intake" },
      { "command": "zooAgentLauncher.copyAgentRun", "title": "Zoo Agent Launcher: Copy /agent-run Command" },
      { "command": "zooAgentLauncher.openZooCode", "title": "Zoo Agent Launcher: Open Zoo Code" },
      { "command": "zooAgentLauncher.resetWorkspacePrompt", "title": "Zoo Agent Launcher: Reset Current Workspace Prompt" },
      { "command": "agentGovernance.showQuickActions", "title": "Agent: Quick Actions" },
      { "command": "agentGovernance.showProgress", "title": "Agent: Show Progress" },
      { "command": "agentGovernance.redirectCurrentRun", "title": "Agent: Redirect Current Run" },
      { "command": "agentGovernance.copyResumeCommand", "title": "Agent: Copy Resume Command" },
      { "command": "agentGovernance.stopThenSnapshot", "title": "Agent: Stop Then Snapshot" },
      { "command": "agentGovernance.openLatestProgress", "title": "Agent: Open Latest Progress" },
      { "command": "agentGovernance.openTaskBoard", "title": "Agent: Open Task Board" },
      { "command": "agentGovernance.applyTaskBoard", "title": "Agent: Apply Task Board" },
      { "command": "agentGovernance.runResumeSafetyCheck", "title": "Agent: Run Resume Safety Check" },
      { "command": "agentGovernance.openMergeQueue", "title": "Agent: Open Merge Queue" },
      { "command": "agentGovernance.openResourceLocks", "title": "Agent: Open Resource Locks" },
      { "command": "agentGovernance.openParallelReport", "title": "Agent: Open Parallel Report" },
      { "command": "agentGovernance.refreshProgressTree", "title": "Agent: Refresh Tree" },
      { "command": "agentGovernance.openLatestRunFolder", "title": "Agent: Open Latest Run Folder" },
      { "command": "agentGovernance.generateCodexTaskPack", "title": "Agent: Generate Codex Task Pack" },
      { "command": "agentGovernance.runCodexWorker", "title": "Agent: Run Codex Worker" },
      { "command": "agentGovernance.openCodexTaskPrompt", "title": "Agent: Open Codex Task Prompt" },
      { "command": "agentGovernance.copyCodexTaskPrompt", "title": "Agent: Copy Codex Task Prompt" },
      { "command": "agentGovernance.collectCodexResult", "title": "Agent: Collect Codex Result" },
      { "command": "agentGovernance.runCodexScopeGuard", "title": "Agent: Run Codex Scope Guard" },
      { "command": "agentGovernance.openCodexResult", "title": "Agent: Open Codex Result" },
      { "command": "agentGovernance.runExecutorBenchmark", "title": "Agent: Run Executor Benchmark" },
      { "command": "agentGovernance.bootstrapProject", "title": "Agent: Bootstrap Project" },
      { "command": "agentGovernance.openBootstrapReport", "title": "Agent: Open Bootstrap Report" },
      { "command": "agentGovernance.rerunBootstrap", "title": "Agent: Re-run Bootstrap" },
      { "command": "agentGovernance.commitBootstrapFiles", "title": "Agent: Commit Bootstrap Files" },
      { "command": "agentGovernance.openProjectReadiness", "title": "Agent: Open Project Readiness" },
      { "command": "agentGovernance.showNodeDetails", "title": "Agent: Show Node Details" },
      { "command": "agentGovernance.copyBranchId", "title": "Agent: Copy Branch ID" },
      { "command": "agentGovernance.redirectFromBranch", "title": "Agent: Redirect From This Branch" },
      { "command": "agentGovernance.openWorktreePath", "title": "Agent: Open Worktree Path" },
      { "command": "agentGovernance.openProgressMarkdown", "title": "Agent: Open Progress Markdown" }
    ],
    "views": {
      "explorer": [
        {
          "id": "agentGovernanceProgress",
          "name": "Agent Progress"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentGovernance.showProgress",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.refreshProgressTree",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentGovernance.showNodeDetails",
          "when": "view == agentGovernanceProgress && viewItem == branch",
          "group": "inline"
        },
        {
          "command": "agentGovernance.copyBranchId",
          "when": "view == agentGovernanceProgress && viewItem == branch",
          "group": "inline"
        },
        {
          "command": "agentGovernance.redirectFromBranch",
          "when": "view == agentGovernanceProgress && viewItem == branch",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openWorktreePath",
          "when": "view == agentGovernanceProgress && viewItem == branch",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openProgressMarkdown",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openTaskBoard",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.applyTaskBoard",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.runResumeSafetyCheck",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openMergeQueue",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openResourceLocks",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openParallelReport",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.bootstrapProject",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openBootstrapReport",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.generateCodexTaskPack",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.runCodexWorker",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.collectCodexResult",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.openCodexResult",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        },
        {
          "command": "agentGovernance.copyResumeCommand",
          "when": "view == agentGovernanceProgress",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Zoo Agent Launcher",
      "properties": {
        "zooAgentLauncher.enabled": { "type": "boolean", "default": true },
        "zooAgentLauncher.onlyGitRepos": { "type": "boolean", "default": true },
        "zooAgentLauncher.promptMode": { "type": "string", "enum": ["oncePerWorkspace", "everyOpen", "manualOnly"], "default": "oncePerWorkspace" },
        "zooAgentLauncher.promptDelayMs": { "type": "number", "default": 2500, "minimum": 0, "maximum": 30000 },
        "zooAgentLauncher.requireAgentRunCommand": { "type": "boolean", "default": true },
        "zooAgentLauncher.defaultArgument": { "type": "string", "default": "first-run governance intake: read-only project profile discovery, global governance validation, local AGENTS/.roo/.roomodes conflict check, no production code edits, no destructive commands, no secrets." },
        "zooAgentLauncher.newTab": { "type": "boolean", "default": true },
        "zooAgentLauncher.pythonCommand": { "type": "string", "default": "D:\\Anaconda\\python.exe" },
        "zooAgentLauncher.zooExtensionIds": { "type": "array", "items": { "type": "string" }, "default": ["ZooCodeOrganization.zoo-code", "RooVeterinaryInc.roo-cline", "RooVeterinaryInc.Roo-Code"] },
        "zooAgentLauncher.zooOpenCommands": { "type": "array", "items": { "type": "string" }, "default": ["workbench.view.extension.zoo-code-ActivityBar", "zoo-code.plusButtonClicked", "zoo-code.focusInput", "workbench.view.extension.roo-cline-ActivityBar", "roo-cline.plusButtonClicked", "roo-cline.focusInput"] }
      }
    }
  }
}
